# ─────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copia este archivo como .env.local para desarrollo local.
# Las variables de producción se configuran en el dashboard de Render.
# ─────────────────────────────────────────────────────────────────

# URL pública del backend Express
# - Local:       http://localhost:3001
# - Producción:  https://tu-app.onrender.com
VITE_API_URL=http://localhost:3001

# Storage backend del servidor Express
# - "json"      → lee/escribe archivos JSON locales (desarrollo)
# - "supabase"  → lee/escribe en Supabase Postgres (producción)
STORAGE_BACKEND=json

# Credenciales de Supabase (solo necesarias si STORAGE_BACKEND=supabase)
# Las encuentras en: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
